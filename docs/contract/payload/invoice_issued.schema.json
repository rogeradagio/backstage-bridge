{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Payload invoice_issued",
  "description": "Factura fiscal d'Odoo. Magento la reflecteix: enllaç amb la factura de captura existent (cas A) o factura mirall nova sense captura (cas B). Sempre amb notification.mode=suppress.",
  "type": "object",
  "additionalProperties": false,
  "required": ["odoo_invoice_id", "odoo_invoice_number", "issued_at", "currency", "items", "grand_total"],
  "properties": {
    "odoo_invoice_id": { "type": "integer", "description": "account.move id" },
    "odoo_invoice_number": { "type": "string", "description": "Ex.: INV/2026/00001" },
    "issued_at": { "type": "string", "format": "date-time" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order_item_id", "sku", "qty"],
        "properties": {
          "order_item_id": { "type": "integer" },
          "sku": { "type": "string" },
          "qty": { "type": "number", "exclusiveMinimum": 0 },
          "unit_price": { "type": "number" },
          "tax_amount": { "type": "number" },
          "row_total_incl_tax": { "type": "number", "description": "Es compara amb Magento (tolerància 0,01)" }
        }
      }
    },
    "shipping_amount": { "type": "number" },
    "shipping_tax_amount": { "type": "number" },
    "grand_total": { "type": "number", "description": "Es compara amb Magento (tolerància 0,02)" },
    "payment_state": { "type": "string", "description": "payment_state d'Odoo; només informatiu" },
    "accept_mismatch": { "type": "boolean", "description": "Accepta diferències d'import com a excepció auditada (requereix suppress)" },
    "replay": { "type": "boolean" }
  }
}
