<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- Única ruta: només POST. Cap GET públic. -->
    <route url="/V1/backstage/events" method="POST">
        <service class="Backstage\Bridge\Api\FulfillmentEventManagementInterface" method="submit"/>
        <resources>
            <resource ref="Backstage_Bridge::events_write"/>
        </resources>
    </route>
</routes>
